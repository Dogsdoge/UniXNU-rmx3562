 // SPDX-License-Identifier: BSD-2-Clause-Patent
 #pragma once
+
+// ---- unixnu-root-extents: file-backed root in userdata (DMU port) ---------------
+// When /chosen carries unixnu-root-extents (u64 triples {fileBlock, partBlock, count},
+// 4 KiB units) and unixnu-root-blocks, the root image is a pinned, preallocated
+// file inside Android's userdata. All reads that would go to the userdata
+// partition are remapped through this table into the file's physical blocks.
+// This is the ShengUfs/IOKit port of ios-fuxi's 0088-fuxi-extent-root.patch.
+#define UX_MAX_EXTENTS 512
+struct UXExtent { uint64_t file, part, count; };
+static UXExtent ux_ext[UX_MAX_EXTENTS];
+static unsigned ux_next;
+static bool ux_root;
+static uint64_t ux_part_first;   // userdata first LBA on LUN 0 (4 KiB units)
+
+// Map a file-relative 4K block to the userdata-partition-relative block.
+static bool ux_map (uint64_t fileBlock, uint64_t *partBlock, uint64_t *run)
+{
+  if (!ux_root) return false;
+  for (unsigned i = 0; i < ux_next; i++) {
+    if (fileBlock >= ux_ext[i].file && fileBlock - ux_ext[i].file < ux_ext[i].count) {
+      uint64_t off = fileBlock - ux_ext[i].file;
+      *partBlock = ux_ext[i].part + off;
+      *run = ux_ext[i].count - off;
+      return true;
+    }
+  }
+  return false;
+}
+
+// Load and validate the extent table from the device tree.
+static int ux_load_extents (void)
+{
+  DTEntry chosen;
+  uint64_t const *ext = NULL, *blocks = NULL;
+  unsigned int size = 0, bsize = 0;
+  if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+      SecureDTGetProperty(chosen, "unixnu-root-extents", (void const **)&ext, &size) != kSuccess ||
+      SecureDTGetProperty(chosen, "unixnu-root-blocks", (void const **)&blocks, &bsize) != kSuccess ||
+      bsize != sizeof(uint64_t) || size == 0 || size % (3 * sizeof(uint64_t)) ||
+      size / (3 * sizeof(uint64_t)) > UX_MAX_EXTENTS) {
+    return ENXIO;
+  }
+  unsigned n = size / (3 * sizeof(uint64_t));
+  uint64_t want = *blocks, pos = 0;
+  for (unsigned i = 0; i < n && pos < want; i++) {
+    uint64_t file = ext[3*i], part = ext[3*i+1], count = ext[3*i+2];
+    if (file != pos || !count) return EINVAL;
+    count = MIN(count, want - pos);
+    for (unsigned j = 0; j < ux_next; j++) {
+      if (part < ux_ext[j].part + ux_ext[j].count && ux_ext[j].part < part + count) return EINVAL;
+    }
+    ux_ext[ux_next] = {file, part, count};
+    ux_next++;
+    pos += count;
+  }
+  if (pos != want) { ux_next = 0; return EINVAL; }
+  ux_root = true;
+  return 0;
+}
