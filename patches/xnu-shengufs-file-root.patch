--- a/ShengUfs/RootWindowRead.h
+++ b/ShengUfs/RootWindowRead.h
@@ -24,6 +24,15 @@ static UfsWindowResult ufsReadWindow (Ops &ops, uint64_t absolute, uint64_t byte
   UfsWindowGuard<Ops> guard (ops);
   uint64_t start = absolute + block * 512, remaining = count * 512;
   UfsWindowResult result = { kIOReturnSuccess, 0 };
   while (remaining) {
+#if defined(UNIXNU_FILE_ROOT)
+    if (ux_root) {
+      // 'absolute' is relative to the file when ux_root: convert file block
+      // to the physical userdata block through the extent table.
+      uint64_t fileBlock = (start + result.done) / 4096;
+      uint64_t skip = (start + result.done) % 4096;
+      uint64_t pb = 0, run = 0;
+      if (!ux_map(fileBlock, &pb, &run)) { result.status = kIOReturnIOError; break; }
+      uint64_t blocks = (skip + remaining + 4095) / 4096;
+      if (blocks > run) blocks = (uint32_t)run;
+      if (blocks > kDataMax / 4096) blocks = kDataMax / 4096;
+      result.status = ops.read (ux_part_first + pb, (uint32_t)blocks, bounce);
+      if (result.status != kIOReturnSuccess) break;
+      uint64_t usable = blocks * 4096 - skip;
+      if (usable > remaining) usable = remaining;
+      uint64_t copied = ops.copy (result.done, bounce + skip, usable);
+      if (copied != usable) { result.status = kIOReturnIOError; break; }
+      result.done += copied;
+      remaining -= usable;
+      continue;
+    }
+#endif
     uint64_t lba = (start + result.done) / 4096, skip = (start + result.done) % 4096;
