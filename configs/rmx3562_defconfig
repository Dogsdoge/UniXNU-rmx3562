# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# Applied after arch:configs/common.config, soc:configs/mt6895.config and os:configs/ios.config.
#
# RMX3562 (MT6895 / Dimensity 8100). SoC-level gates come from mt6895-common;
# this file holds device-level decisions only.

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# Storage: iOS root lives in a pinned raw-block file in userdata (DSU method).
# ShengUfs-mt6895 (3-layer driver) provides native UFS + extent mapping;
# its archive is selected in board.toml [kernel] archives when build-ready.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_BUILD_ARCHIVES=y
# Do NOT set XNU_EXTRA_LD_ARCHIVES here: with CONFIG_XNU_NATIVE_UFS=y the
# build-xnu script already force-loads build/sheng-ufs/libShengUfs.a. Adding a
# second -force_load here links the same objects twice (duplicate symbols).

# Display: LK-initialized framebuffer at 0xFE1AF000 (RMX3562), copied by GopFramebuffer.
# Input: Synaptics S3910 @ I2C and Tianma ILI7838A panel need device drivers (TBD).
# CONFIG_XNU_NATIVE_GPU is not set
